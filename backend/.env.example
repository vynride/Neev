# Copy to backend/.env and fill in. Never commit .env.

# LLM (OpenAI or any compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# responses | chat
LLM_API=responses
MODEL_FAST=gpt-5.6-luna
MODEL_STRONG=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-small

# Supabase Postgres: use the SESSION POOLER string (Connect > Session pooler). It works over IPv4.
# The direct db.<ref>.supabase.co host is IPv6-only and fails on many networks.
# postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# MongoDB Atlas
MONGO_URL=
MONGO_DB=mentor

# Web search for learning resources
EXA_API_KEY=

# ClickUp personal token (avatar > Settings > Apps). Then run: python -m scripts.clickup_setup
CLICKUP_TOKEN=
CLICKUP_ENABLED=false

# Post-MVP
SARVAM_API_KEY=

# Server
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_SECRET=change-me
REPOS_DIR=./data/repos
