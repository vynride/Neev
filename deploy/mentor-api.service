[Unit]
Description=Barabari AI Mentor API
After=network-online.target
Wants=network-online.target

[Service]
User=force
WorkingDirectory=/home/force/Team-21/backend
ExecStart=/home/force/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
